# Copy to gb-chat/.env and fill in. Never commit the real file.

# --- Engine API (the GB Chat server is its only client) ---
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
# Long random string. The GB Chat server sends it as GB_CHAT_ENGINE_KEY.
API_SERVER_KEY=

# --- Model provider: set the one IT approved, then pick the model once with ---
#     HERMES_HOME=gb-chat/.engine-home python -m hermes_cli.main model
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=

# --- GB Chat server ---
GB_CHAT_HOST=127.0.0.1
GB_CHAT_PORT=8080
# "engine" talks to the engine API above. "mock" runs a built-in demo engine (no model needed).
GB_CHAT_ENGINE=engine
GB_CHAT_ENGINE_URL=http://127.0.0.1:8642
# Same value as API_SERVER_KEY.
GB_CHAT_ENGINE_KEY=

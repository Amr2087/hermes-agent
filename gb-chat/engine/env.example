# Copy to gb-chat/.env and fill in. Never commit the real file.

# --- Engine API (the GB Chat server is its only client) ---
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
# Long random string. The GB Chat server sends it as GB_CHAT_ENGINE_KEY.
API_SERVER_KEY=

# --- Model: OpenAI GPT on Microsoft Foundry (Azure AI Foundry) ---
# Endpoint from the Foundry portal ("Keys and Endpoint"), ending in /openai/v1, e.g.
#   https://<resource>.openai.azure.com/openai/v1
#   https://<resource>.services.ai.azure.com/openai/v1
# Stop at /openai/v1: don't add /responses (start-engine.sh trims it if you do).
AZURE_FOUNDRY_BASE_URL=
# Key from the same page. Leave empty when AZURE_FOUNDRY_AUTH_MODE=entra_id.
AZURE_FOUNDRY_API_KEY=
# The deployment name you gave the model in Foundry (not always the model name).
AZURE_FOUNDRY_DEPLOYMENT=gpt-6-luna
# api_key, or entra_id (managed identity / az login; needs the "Azure AI User" role on the resource).
AZURE_FOUNDRY_AUTH_MODE=api_key

# --- GB Chat server ---
GB_CHAT_HOST=127.0.0.1
GB_CHAT_PORT=8080
# "engine" talks to the engine API above. "mock" runs a built-in demo engine (no model needed).
GB_CHAT_ENGINE=engine
GB_CHAT_ENGINE_URL=http://127.0.0.1:8642
# Same value as API_SERVER_KEY.
GB_CHAT_ENGINE_KEY=

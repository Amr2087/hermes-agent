# GB Knowledge MCP server. Copy to gb-chat/mcp/knowledge/.env and fill in. Never commit the real file.
# This file holds a Corp-ChatWithData secret: keep it out of gb-chat/.env (the agent engine's env).

# Where the server listens. The GB Chat engine connects to http://<host>:<port>/mcp
KNOWLEDGE_MCP_HOST=127.0.0.1
KNOWLEDGE_MCP_PORT=8711
# Long random key (openssl rand -hex 32). Put the same value in gb-chat/.env as GB_KNOWLEDGE_MCP_KEY.
KNOWLEDGE_MCP_KEY=

# --- Corp-ChatWithData ---
# tenancy (published on 8101) and retrieval (published on 8103) in a default deploy/compose setup.
TENANCY_URL=http://127.0.0.1:8101
RETRIEVAL_URL=http://127.0.0.1:8103
# The same SERVICE_JWT_SECRET as deploy/compose/.env in Corp-ChatWithData.
SERVICE_JWT_SECRET=
# Caller name in service tokens and audit rows.
SERVICE_NAME=gb-knowledge-mcp

# --- Limits ---
KNOWLEDGE_DEFAULT_TOP_K=8
KNOWLEDGE_MAX_TOP_K=20
KNOWLEDGE_MAX_CHUNK_CHARS=2000
KNOWLEDGE_TIMEOUT_SECONDS=60
# Write one tenancy audit row per search (true/false).
KNOWLEDGE_AUDIT=true

# GB Power BI MCP server. Copy to gb-chat/mcp/powerbi/.env and fill in. Never commit the real file.
# This file holds Corp-ChatWithData secrets: keep it out of gb-chat/.env (the agent engine's env).

# Where the server listens. The GB Chat engine connects to http://<host>:<port>/mcp
POWERBI_MCP_HOST=127.0.0.1
POWERBI_MCP_PORT=8712
# Long random key (openssl rand -hex 32). Put the same value in gb-chat/.env as GB_POWERBI_MCP_KEY.
POWERBI_MCP_KEY=

# --- Corp-ChatWithData ---
# tenancy is published on 8101 in a default deploy/compose setup.
TENANCY_URL=http://127.0.0.1:8101
# The same SERVICE_JWT_SECRET and CORE_SECRET_KEY as deploy/compose/.env in Corp-ChatWithData.
# CORE_SECRET_KEY decrypts each org unit's Power BI service-principal secret.
SERVICE_JWT_SECRET=
CORE_SECRET_KEY=
# Caller name in service tokens and audit rows.
SERVICE_NAME=gb-powerbi-mcp

# --- Optional: offer the existing Power BI pipeline as ask_powerbi, for comparison ---
# agent-powerbi publishes no port by default; expose it on the private network first.
AGENT_POWERBI_URL=
AGENT_POWERBI_AUDIENCE=agent-powerbi

# --- Limits ---
POWERBI_DEFAULT_ROWS=200
POWERBI_MAX_ROWS=1000
POWERBI_MAX_DAX_CHARS=20000
POWERBI_QUERY_TIMEOUT_SECONDS=60
# Write one tenancy audit row per query (true/false).
POWERBI_AUDIT=true
